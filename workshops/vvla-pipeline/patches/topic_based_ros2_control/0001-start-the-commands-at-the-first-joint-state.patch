+CallbackReturn TopicBasedSystem::on_activate(const rclcpp_lifecycle::State& /*previous_state*/)
+{
+  // write() publishes the commands from now on, and until a controller writes
+  // them they hold their initial values: start them at the measured state.
+  if (initial_state_timeout_ <= 0.0)
+  {
+    return CallbackReturn::SUCCESS;
+  }
+  sensor_msgs::msg::JointState first;
+  if (!rclcpp::wait_for_message(first, node_, joint_states_topic_, std::chrono::duration<double>(initial_state_timeout_),
+                                rclcpp::SensorDataQoS()))
+  {
+    RCLCPP_ERROR(node_->get_logger(), "No joint state on '%s' within %.1f s", joint_states_topic_.c_str(),
+                 initial_state_timeout_);
+    return CallbackReturn::ERROR;
+  }
+  latest_joint_state_ = first;
+  read(node_->now(), rclcpp::Duration(0, 0));
+  joint_commands_[POSITION_INTERFACE_INDEX] = joint_states_[POSITION_INTERFACE_INDEX];
+  return CallbackReturn::SUCCESS;
+}
