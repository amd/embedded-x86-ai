# Grammar for the intent router: the model can ONLY emit
#   {"command": "<one of the known commands>", "object": "<0-2 plain words>"}
# so JSON parsing can never fail and unknown verbs collapse to "unknown".

root    ::= "{" ws "\"command\"" ws ":" ws cmd ws "," ws "\"object\"" ws ":" ws obj ws "}"

cmd     ::= "\"gesture_mimic\"" | "\"fetch_block\"" | "\"pick_place\"" |
            "\"dance\"" | "\"grip\"" | "\"release\"" | "\"wave\"" | "\"home\"" |
            "\"stop\"" | "\"unknown\""

# Object: empty, or 1-2 lowercase words ("ball", "water bottle").
obj     ::= "\"\"" | "\"" word (" " word)? "\""
word    ::= [a-z] [a-z]{0,15}

ws      ::= [ \t]*
